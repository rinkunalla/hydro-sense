{
  "rules": {
    ".read": false,
    ".write": false,
    "members": {
      ".read": false,
      ".write": false
    },
    "live": {
      ".read": "auth != null && root.child('members').child(auth.uid).val() === true"
    },
    "state": {
      ".read": false,
      ".write": false
    },
    "series": {
      ".read": "auth != null && root.child('members').child(auth.uid).val() === true"
    }
  }
}
