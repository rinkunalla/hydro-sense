{
  "rules": {
    ".read": false,
    ".write": false,
    "live": {
      "$deviceId": {
        ".read": "auth != null && auth.token.role == 'user' && data.child('ownerUid').val() == auth.uid"
      }
    },
    "state": {
      ".read": false,
      ".write": false
    },
    "series": {
      "$deviceId": {
        ".read": "auth != null && auth.token.role == 'user' && root.child('live').child($deviceId).child('ownerUid').val() == auth.uid"
      }
    }
  }
}
