rules_version = '2';

// Access model (v3, D62 to D66): one organization. Every active member (staff
// and admins) reads every device, its health, History and the one pipeline;
// only admins write, and only where a rule below allows it. Devices change only
// through callables. Cloud Functions use the Admin SDK and bypass these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The claim alone stays valid for up to an hour after an admin is removed, so
    // an active admins/{uid} record is also required (same check as the callables).
    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin'
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == 'active';
    }

    // Staff have role "user"; a disabled account is refused at once, before its
    // ID token expires.
    function isStaff() {
      return signedIn() && request.auth.token.role == 'user'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isMember() {
      return isAdmin() || isStaff();
    }

    function isSelfStaff(uid) {
      return isStaff() && request.auth.uid == uid;
    }

    function textOf(s, max) {
      return s is string && s.size() >= 1 && s.size() <= max && s.matches('.*\\S.*');
    }

    function validLat(v) {
      return v is number && v >= -90 && v <= 90;
    }

    function validLng(v) {
      return v is number && v >= -180 && v <= 180;
    }

    // Pipeline: rules have no loops, so the 10 branches are checked one by one.
    // A request may evaluate at most 1,000 expressions, so each branch check is kept
    // small: allowed keys, types and sizes (abuse limits). Every key is read, and
    // reading a missing key denies the write, so no hasAll() is needed. Coordinate ranges and the
    // entries of deviceIds only affect the user's own map, which reads them defensively.
    function validBranch(b) {
      return b.keys().hasOnly(['id', 'endName', 'endLat', 'endLng', 'deviceIds'])
        && b.id is string && b.id.size() <= 40
        && b.endName is string && b.endName.size() >= 1 && b.endName.size() <= 40
        && b.endLat is number && b.endLng is number
        && b.deviceIds is list && b.deviceIds.size() <= 50;
    }

    function branchOk(list, i) {
      return list.size() <= i || validBranch(list[i]);
    }

    function validPipeline(d) {
      return d.keys().hasOnly(['name', 'source', 'branches', 'updatedAt', 'rotation'])
        // The map direction everyone opens with, in degrees (2026-11-25).
        && (!('rotation' in d) || (d.rotation is number && d.rotation > -180 && d.rotation <= 180))
        && textOf(d.name, 40)
        && d.source is map && d.source.keys().hasOnly(['name', 'lat', 'lng'])
        && textOf(d.source.name, 40) && validLat(d.source.lat) && validLng(d.source.lng)
        && d.branches is list && d.branches.size() <= 10
        && branchOk(d.branches, 0) && branchOk(d.branches, 1) && branchOk(d.branches, 2)
        && branchOk(d.branches, 3) && branchOk(d.branches, 4) && branchOk(d.branches, 5)
        && branchOk(d.branches, 6) && branchOk(d.branches, 7) && branchOk(d.branches, 8)
        && branchOk(d.branches, 9)
        && d.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read: if isSelfStaff(uid) || isAdmin();

      // Registered only through claimPushToken, which first removes the
      // phone from any other account; the staff member may delete it (Sign out).
      match /push_tokens/{token} {
        allow read, delete: if isSelfStaff(uid);
      }
    }

    match /admins/{uid} {
      allow read: if isAdmin();
    }

    // Changed only through the admin callables (updateDevice, D63).
    match /devices/{deviceId} {
      allow read: if isMember();

      match /flow_logs/{logId} {
        allow read: if isMember();
      }
    }

    match /device_health/{deviceId} {
      allow read: if isMember();
    }

    // History: only the functions create and close problems; an admin may
    // delete one that has ended.
    match /problems/{id} {
      allow read: if isMember();
      allow delete: if isAdmin() && resource.data.endedAt != null;
    }

    // The History graph: one day of 15-minute flow samples per device.
    match /readings/{id} {
      allow read: if isMember();
    }

    // The organization's one pipeline (pipelines/main); the admin edits it.
    match /pipelines/{id} {
      allow read: if isMember() && id == 'main';
      allow delete: if isAdmin() && id == 'main';
      allow create, update: if isAdmin() && id == 'main' && validPipeline(request.resource.data);
    }

    match /allowed_devices/{deviceId} {
      allow read: if isAdmin();
    }

    // device_secrets, phone_index, admin_setup_tokens, alert_state, alert_daily,
    // rate_limits, error_logs (Firebase console only) and every unlisted path:
    // no person may read or write them (no matching allow rule means deny).
  }
}
