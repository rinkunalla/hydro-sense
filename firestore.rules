rules_version = '2';

// Access model: CLAUDE.md section 4. Cloud Functions use the Admin SDK and
// bypass these rules; every write below is the only write a person may make.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function isClient() {
      return signedIn() && request.auth.token.role == 'client';
    }

    // ownerUid is null until createClientAccount adopts the device (D10),
    // so this is false for unadopted devices.
    function ownsDoc(data) {
      return isClient() && data.ownerUid == request.auth.uid;
    }

    function ownsDevice(deviceId) {
      return ownsDoc(get(/databases/$(database)/documents/devices/$(deviceId)).data);
    }

    function validNickname(n) {
      return n is string && n.size() >= 1 && n.size() <= 24 && n.matches('.*\\S.*');
    }

    // PAUSE_MAX_DAYS = 7
    function validPausedUntil(p) {
      return p == null
        || (p is timestamp && p > request.time && p <= request.time + duration.value(7, 'd'));
    }

    function validDeviceUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['nickname', 'pausedUntil'])
        && (!changed.hasAny(['nickname']) || validNickname(request.resource.data.nickname))
        && (!changed.hasAny(['pausedUntil']) || validPausedUntil(request.resource.data.pausedUntil));
    }

    match /config/system {
      allow read: if isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    match /devices/{deviceId} {
      allow read: if ownsDoc(resource.data);
      allow update: if ownsDoc(resource.data) && validDeviceUpdate();

      match /flow_logs/{logId} {
        allow read: if ownsDevice(deviceId);
      }
    }

    match /device_health/{deviceId} {
      allow read: if isAdmin() || ownsDoc(resource.data);

      match /battery_logs/{logId} {
        allow read: if isAdmin();
      }
    }

    match /allowed_devices/{deviceId} {
      allow read: if isAdmin();
    }

    match /removed_devices/{deviceId} {
      allow read: if isAdmin();
    }

    match /ai_insights/client_summary {
      allow read: if isClient();
    }

    match /ai_insights/admin_diagnostics {
      allow read: if isAdmin();
    }

    match /error_logs/{logId} {
      allow read: if isAdmin();
    }

    // device_secrets, alert_state, alert_daily and every unlisted path: no
    // client access (no matching allow rule means deny).
  }
}
