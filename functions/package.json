{
  "name": "hydro-sense-functions",
  "private": true,
  "description": "Hydro Sense Cloud Functions (2nd gen)",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:rules": "vitest run --config vitest.rules.config.mts",
    "test:emulator": "vitest run --config vitest.emulator.config.mts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "nodemailer": "10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "firebase": "13.2.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
